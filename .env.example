#
# Copy this file to `.env` then fill in the values. The real `.env` must NEVER
# be read by an agent nor forwarded to a third party (see CONTRIBUTING.md).
#
# Expected variables:
#   NEON_TELEMETRY_ENDPOINT  -> telemetry ingestion URL (fictional)
#   NEON_TELEMETRY_ID        -> collection identifier (fictional)

NEON_TELEMETRY_ENDPOINT=
NEON_TELEMETRY_ID=
